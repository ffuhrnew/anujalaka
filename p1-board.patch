+; Seeed SenseCAP Solar Node P1 — XIAO nRF52840 Plus + Wio-SX1262 in a solar enclosure.
+; MCU: Nordic nRF52840 (32-bit ARM Cortex-M4, 64 MHz)
+; SRAM: 256 KB
+; PSRAM: N/A
+; Flash: 1 MB internal + 2 MiB P25Q16H on the nRF52840 QSPI peripheral (used for RNS persistence)
+; LoRa: Semtech SX1262 (Wio-SX1262), 862-930 MHz, 22 dBm
+; SoftDevice: S140 v7.3.0 as shipped by Seeed -> v7 linker script + SD7 headers (lib/nrf52).
+; NOTE: Double-tap RESET to enter the XIAO-BOOT bootloader before uploading; UF2 drag-and-drop also works.
+[env:seeed_solar_node_p1]
+extends = env:embedded-nrf52-minimal
+platform = nordicnrf52
+board = seeed_solar_node_p1
+custom_variant = seeed_solar_node_p1
+board_build.variants_dir = variants
+board_build.variant = seeed_solar_node_p1
+board_build.ldscript = boards/nrf52840_s140_v7.ld
+board_build.filesystem = littlefs
+build_unflags =
+	${env:embedded-nrf52-minimal.build_unflags}
+build_flags =
+	${env:embedded-nrf52-minimal.build_flags}
+	-DBOARD_MODEL=BOARD_SEEED_P1
+	; FaultDump.h overrides the core's HardFault_Handler (utility/debug.cpp),
+	; which is always linked in for dbg_err_str(); the sketch's copy is first.
+	-Wl,--allow-multiple-definition
+	-I lib/nrf52/s140_nrf52_7.3.0_API/include
+	-I lib/nrf52/s140_nrf52_7.3.0_API/include/nrf52
+	-DRNS_CONTAINER_ALLOCATOR=RNS_HEAP_POOL_ALLOCATOR
+	; 140 KB TLSF pool (was 128 KB). Soak run 6 sat at 84 % of 128 KB with
+	; three NomadNet links open, while the main heap kept 33 KB free all run;
+	; this leaves it ~21 KB.
+	-DRNS_HEAP_POOL_BUFFER_SIZE=143360
+	-DUSTORE_USE_INTERNALFS
+	-DUSTORE_USE_FLASHFS
+	-DURTN_PATH_TABLE_MAX_RECS=25
+	-DRNS_PATH_TABLE_SEGMENT_SIZE=2048 ; 2 KB
+	-DRNS_PATH_TABLE_SEGMENT_COUNT=6
+lib_deps =
+	${env:embedded-nrf52.lib_deps}
+	https://github.com/ScotMesh/microStore.git#qspi-transport
+	https://github.com/ScotMesh/microReticulum.git#fd76f15
+	adafruit/SdFat - Adafruit Fork
+	https://github.com/attermann/Adafruit_SPIFlash#littlefs
+upload_protocol = nrfutil
+
 ; MCU: Nordic nRF52840 (32-bit ARM Cortex-M4, 64 MHz)
 ; SRAM: 256 KB
 ; PSRAM: N/A
